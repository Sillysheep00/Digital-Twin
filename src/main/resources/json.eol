// Calculation Logic (Fast Estimation - Consistent with Training)
var realPower = 0.0d;
if (simulateData.isDefined()) { realPower = simulateData.powerConsumption; }

var allHvacs = SmartOffice!HVACSystem.all;
var allRooms = SmartOffice!Room.all;
var allEnergySensors = SmartOffice!EnergyMeter.all;

var totalCapacity = allRooms.collect(r | r.capacity).sum();
var totalBuildingOccupancy = 0.0;
if (simulateData.isDefined()) { totalBuildingOccupancy = simulateData.occupancy; }

// Fast estimation constants (same as RegressionTrainingService)
var HVAC_POWER_PER_UNIT = 5.0d;
var HVAC_DUTY_CYCLE = 0.35d;
var STANDBY_RATIO = 0.1d;

// Calculate Room Data List (for room-level display)
var roomJsonList = new Sequence();

// Fast estimation: HVAC power (constant based on HVAC count)
var hvacCount = allHvacs.size();
var estimatedHvacPower = hvacCount * HVAC_POWER_PER_UNIT * HVAC_DUTY_CYCLE;

// Fast estimation: Plug load (occupancy-based, same as training)
var totalBaseLoad = allRooms.collect(r | r.baseLoad).sum();
var estimatedPlugPower = 0.0d;
if (totalBuildingOccupancy > 0) {
    estimatedPlugPower = totalBaseLoad;  // Full power when occupied
} else {
    estimatedPlugPower = totalBaseLoad * STANDBY_RATIO;  // Standby when empty
}

// Total simulated power (fast estimation)
var simulatedTotalPower = estimatedHvacPower + estimatedPlugPower;


// Sum actual HVAC powerUsage + plugLoad (computed by hvac.eol)
var physicsHvacPower = 0.0d;
var physicsPlugPower = 0.0d;

for (r in allRooms) {
    // HVAC power from actual hvac.eol decision
    if (r.hvac.isDefined() and r.hvac.status == true) {
        physicsHvacPower = physicsHvacPower + r.hvac.powerUsage;
    }
    
    // Plug power stored by hvac.eol (fallback to baseLoad if not set)
    if (r.plugLoad.isDefined()) {
        physicsPlugPower = physicsPlugPower + r.plugLoad;
    } else {
        // Fallback: use baseLoad if plugLoad not set
        physicsPlugPower = physicsPlugPower + r.baseLoad;
    }
}

var simulatedPhysicsPower = physicsHvacPower + physicsPlugPower;

// For room-level display, calculate per-room values (physics-based)
for (r in allRooms) {
    // HVAC Power from physics simulation (actual hvac.eol state)
    var hvacStatus = "OFF";
    var currentHvacPower = 0.0d;
    var hasHvac = r.hvac.isDefined();
    
    if (hasHvac) {
        if (r.hvac.status == true) {
            currentHvacPower = r.hvac.powerUsage;  // Actual physics-based HVAC power
            hvacStatus = "ON";
        } else {
            hvacStatus = "OFF";
        }
    }
    
    // Plug Load from physics simulation (actual hvac.eol computation)
    var plugLoad = 0.0d;
    if (r.plugLoad.isDefined()) {
        plugLoad = r.plugLoad;  // Use actual plug load from hvac.eol
    } else {
        // Fallback: use baseLoad if plugLoad not set
        plugLoad = r.baseLoad;
    }

    // Total Current Power for Room (physics-based)
    var roomCurrentPower = currentHvacPower + plugLoad;

    // Accumulated Energy (from Sensor)
    var energyVal = 0.0d;
    var energySensor = r.sensors.selectOne(s | s.isTypeOf(SmartOffice!EnergyMeter));
    if (energySensor.isDefined()) {
        energyVal = energySensor.energyConsumed;
    }

    // Create individual room JSON string
    var roomJson = '{ "id": "' + r.roomID + '", "name": "' + r.roomName + '", "temp": ' + r.currentTemp.format("%.2f") + ', "hvac": "' + hvacStatus + '", "hasHvac": ' + hasHvac + ', "power": ' + roomCurrentPower.format("%.2f") + ', "energy": ' + energyVal.format("%.2f") + ' }';
    roomJsonList.add(roomJson);
}

// Apply ML model (Linear Regression) if available from context (passed from Java)
// Formula: predictedPower = slope × simulatedPower + intercept
var mlSlope = 1.0d;      // slope (a) - learned regression parameter
var mlIntercept = 0.0d;  // intercept (b) - learned regression parameter

if (ML_SLOPE.isDefined()) {
    mlSlope = ML_SLOPE;
}
if (ML_INTERCEPT.isDefined()) {
    mlIntercept = ML_INTERCEPT;
}

// ML-calibrated power: Apply Linear Regression model to adjust simulated power
var calibratedSimulatedPower = (simulatedTotalPower * mlSlope) + mlIntercept;

// Calculate gap between real power and ML-calibrated simulated power
var gap = realPower - calibratedSimulatedPower;
var gapPercentage = 0.0d;
if (realPower > 0) {
    gapPercentage = (gap / realPower) * 100;
}

var simulatedEnergyTotal = allEnergySensors.collect(s | s.energyConsumed).sum().asReal();
var avgTemp = 0.0d;
if (allRooms.size() > 0) {
    avgTemp = allRooms.collect(r | r.currentTemp).sum() / allRooms.size();
} else {
    // Fallback: use default temperature if no rooms found
    avgTemp = 22.0d;
    System.err.println("WARNING: No rooms found in model, using default avgTemp = 22.0°C");
}


// Generate JSON String 
// Build JSON string for internal use  (returned to caller, not printed to console)
var jsonOutput = "{" + "\n";

    if (simulateData.isDefined()) {
    jsonOutput = jsonOutput + '"timestamp": "' + simulateData.date + '",' + "\n";
    } else {
    jsonOutput = jsonOutput + '"timestamp": "N/A",' + "\n";
    }


// Add simulation start time
var simStartTime = "N/A";
if (SIMULATION_START_TIME.isDefined()) {
    simStartTime = SIMULATION_START_TIME;
}
jsonOutput = jsonOutput + '"simulationStartTime": "' + simStartTime + '",' + "\n";

jsonOutput = jsonOutput + '"power": {' + "\n";
jsonOutput = jsonOutput + '  "real": ' + realPower.format("%.2f") + ',' + "\n";
jsonOutput = jsonOutput + '  "simulated_raw": ' + simulatedTotalPower.format("%.2f") + ',' + "\n";
jsonOutput = jsonOutput + '  "simulated_physics_raw": ' + simulatedPhysicsPower.format("%.2f") + ',' + "\n";
jsonOutput = jsonOutput + '  "simulated": ' + calibratedSimulatedPower.format("%.2f") + ',' + "\n";
jsonOutput = jsonOutput + '  "calibration_factor": ' + mlSlope.format("%.4f") + ',' + "\n";
jsonOutput = jsonOutput + '  "hvac": ' + estimatedHvacPower.format("%.2f") + ',' + "\n";
jsonOutput = jsonOutput + '  "plug": ' + estimatedPlugPower.format("%.2f") + ',' + "\n";
jsonOutput = jsonOutput + '  "gap": ' + gap.format("%.2f") + ',' + "\n";
jsonOutput = jsonOutput + '  "gap_percentage": ' + gapPercentage.format("%.1f") + "\n";
jsonOutput = jsonOutput + "}," + "\n";

jsonOutput = jsonOutput + '"energy": {' + "\n";
jsonOutput = jsonOutput + '  "total": ' + simulatedEnergyTotal.format("%.2f") + "\n";
jsonOutput = jsonOutput + "}," + "\n";

jsonOutput = jsonOutput + '"environment": {' + "\n";
var outdoorTempValue = 0.0d;
if (simulateData.isDefined()) {
    outdoorTempValue = simulateData.outdoorTemperature;
}
jsonOutput = jsonOutput + '  "outdoorTemp": ' + outdoorTempValue.format("%.2f") + ',' + "\n";
jsonOutput = jsonOutput + '  "avgIndoorTemp": ' + avgTemp.format("%.2f") + ',' + "\n";
jsonOutput = jsonOutput + '  "activeHvacs": ' + allHvacs.select(h | h.status == true).size() + "\n";
jsonOutput = jsonOutput + "}," + "\n";

jsonOutput = jsonOutput + '"comfort": {' + "\n";
jsonOutput = jsonOutput + '  "avgTemp": ' + avgTemp.format("%.2f") + ',' + "\n";
jsonOutput = jsonOutput + '  "activeHvacs": ' + allHvacs.select(h | h.status == true).size() + "\n";
jsonOutput = jsonOutput + "}," + "\n";

jsonOutput = jsonOutput + '"rooms": [' + "\n";
jsonOutput = jsonOutput + '  ' + roomJsonList.concat(", ") + "\n";
jsonOutput = jsonOutput + "]" + "\n";

jsonOutput = jsonOutput + "}";

// Return the JSON for parsing (captured by ModelService, not printed to console)
return jsonOutput;
